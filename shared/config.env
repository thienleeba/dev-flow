# DevFlow settings — you don't need to edit this file.
# Everything works out of the box; empty = automatic. To change something, just tell the AI
# ("reply in Vietnamese", "I work 4 hours a day"). Personal settings go to ~/.devflow/config.env,
# team settings (labels, project) to the repo's .devflow/config.env. AUTO_* and BASE_BRANCH are personal only.

DEVFLOW_LANG=          # empty = the language you write in
GITHUB_PROJECT=        # empty = the GitHub Project your assigned issues belong to (format owner/number)
WORK_HOURS=6
AUTO_PUSH=false        # true = DevFlow may push your own feature branches without asking
AUTO_DRAFT_PR=false    # true = DevFlow may open draft PRs without asking

# Advanced (rarely changed)
BASE_BRANCH=           # empty = the repo's default branch
NEW_ISSUE_DAYS=3
TRIAGE_LABELS=
NEEDS_INPUT_LABELS=needs-info,question,needs-design,blocked
PRIORITY_LABELS=P0,critical,urgent,High,P1,bug,P2,Middle,Medium,P3,Low
LIMIT=50
